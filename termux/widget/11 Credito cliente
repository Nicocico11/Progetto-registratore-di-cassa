#!/bin/bash
# Pulsante: credito cliente (il cliente prende ora e paga più avanti)
. ~/.termux/tasker/widget_comune.sh
NOME=$(testo "📒 Credito: nome" "Rossi"); [ -z "$NOME" ] && annullato
